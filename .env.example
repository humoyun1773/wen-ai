# ==============================================================================
# WEN AI - Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="WEN AI"
APP_URL=http://localhost:5173
API_V1_STR=/api/v1

# Security & JWT
# Generate secret key using: openssl rand -hex 32
JWT_SECRET_KEY=wen_ai_super_secret_jwt_key_change_in_production_2026_x99!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Default: Local SQLite for zero setup; or PostgreSQL for Production)
DATABASE_URL=sqlite+aiosqlite:///./wen_ai.db
# PostgreSQL Example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wen_ai

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting (Requests per minute)
RATE_LIMIT_FREE_TIER=60

# ==============================================================================
# AI Provider API Keys
# Note: You can provide any or all of these. If no keys are provided, WEN AI
# operates in built-in mock mode so the application runs with full UI interactivity!
# ==============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434

# Qdrant Vector Database (For Document RAG)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Upload Configuration
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads
